# ==================== ANALYTICS DATABASE CONFIGURATION ====================
# You can either use a separate database for analytics or use your existing database

# Option 1: Use separate analytics database (recommended for production)
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=whatsapp_analytics
ANALYTICS_DB_USER=your_analytics_db_user
ANALYTICS_DB_PASSWORD=your_analytics_db_password

# Option 2: Use existing database
# If you don't set ANALYTICS_DB_* variables, the system will use DB_* variables below

# ==================== REDIS CONFIGURATION (REQUIRED) ====================
# Redis is used for caching analytics data
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty if no password

# ==================== EXISTING CONFIGURATION ====================
# Keep all your existing environment variables
PORT=8080

# Main Database (if different from analytics)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_main_database
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# WhatsApp Business API
# (Your existing WhatsApp configuration)

# Django Backend URLs
# (Your existing Django URLs)

# Other existing configurations...
