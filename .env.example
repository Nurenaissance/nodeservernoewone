# Node.js Bot Server Environment Variables Template
# Copy this file to .env and fill in the actual values

# ============================================================================
# SERVICE AUTHENTICATION KEYS (CRITICAL - Keep these secret!)
# ============================================================================
# All services need ALL three keys to validate each other
DJANGO_SERVICE_KEY=sk_django_oOcCi1SfeOtcAY3q5iuH-xzulCnwunYeedAZUFEinNc
FASTAPI_SERVICE_KEY=sk_fastapi_9DoPMGmd4I-5HhX_d68me-A_rwjhz_FANd1M0dIeV6k
NODEJS_SERVICE_KEY=sk_nodejs_mA-XH9BJLiDlmXjA9vGa7XgczT68v3CoQNrcvEx0s34

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# IMPORTANT: Must be the SAME across ALL services (Django, FastAPI, Node.js)
JWT_SECRET_KEY=your-shared-jwt-secret-key-change-this-in-production-make-it-long-and-random
JWT_SECRET=your-shared-jwt-secret-key-change-this-in-production-make-it-long-and-random

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION (Main)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_bot
DB_USER=postgres
DB_PASSWORD=your_database_password

# ============================================================================
# ANALYTICS DATABASE (can be same or separate)
# ============================================================================
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=your_analytics_password

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# SERVICE URLs (for making cross-service API calls)
# ============================================================================
DJANGO_URL=http://localhost:8000
FASTAPI_URL=http://localhost:8001
NODEJS_URL=http://localhost:3000

# ============================================================================
# WHATSAPP / META CONFIGURATION
# ============================================================================
# Webhook verification
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Meta App Secret (for webhook signature validation)
APP_SECRET=your_meta_app_secret_from_developers_console

# WhatsApp Flow Encryption (move from code to env vars)
WHATSAPP_FLOW_PRIVATE_KEY="-----BEGIN ENCRYPTED PRIVATE KEY-----
Your encrypted private key here
-----END ENCRYPTED PRIVATE KEY-----"

WHATSAPP_FLOW_PASSPHRASE=your_flow_encryption_passphrase

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# OpenAI API (for AI features)
OPENAI_API_KEY=sk-your-openai-api-key

# Google Service Account (for Google Sheets, etc.)
GOOGLE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# ============================================================================
# AZURE CONFIGURATION
# ============================================================================
# Azure Blob Storage (for media uploads)
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER=media

# Azure Functions URLs (if using)
AZURE_FUNCTION_MEDIA_PROCESSOR=https://your-function.azurewebsites.net/webhook/process-multiple-media
AZURE_FUNCTION_TEMPLATE_STATUS=https://your-function.azurewebsites.net/webhook/template_status

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# PM2 CONFIGURATION (if using PM2)
# ============================================================================
PM2_INSTANCES=2
PM2_MAX_MEMORY_RESTART=500M

# ============================================================================
# WEBHOOK SIMULATOR (for local/staging testing)
# ============================================================================
# Target URL for simulated webhooks (your local or staging server)
SIMULATOR_WEBHOOK_URL=http://localhost:8080/webhook

# IMPORTANT: Use your REAL WhatsApp Business Phone Number ID!
# Get it from: Meta Business Suite → WhatsApp Accounts → Phone Numbers
# Without this, getSession() will fail because the ID won't exist in Django
SIMULATOR_PHONE_NUMBER_ID=your_real_phone_number_id_here
TEST_PHONE_NUMBER_ID=your_real_phone_number_id_here

# Test user's WhatsApp phone number (with country code, no +)
# This should be a real WhatsApp number you can use for testing
SIMULATOR_USER_PHONE=919876543210
TEST_USER_PHONE=919876543210

# Test user's display name
SIMULATOR_USER_NAME=Test User
TEST_USER_NAME=Test User

# ============================================================================
# NOTES
# ============================================================================
# 1. NEVER commit .env file to git
# 2. All service keys must be the same across all services
# 3. JWT_SECRET_KEY must be the same across all services
# 4. APP_SECRET is from Meta Developer Console
# 5. WEBHOOK_VERIFY_TOKEN is what you set in Meta Developer Console
# 6. Rotate service keys quarterly for security
# 7. Use strong, random values for production
# 8. For production, set NODE_ENV=production
# 9. Use the webhook simulator for local testing before deploying
